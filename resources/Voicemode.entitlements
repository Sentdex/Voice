<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Recording is the whole point. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Driving System Events to paste the transcript and to copy the selection. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- py2app bundles third-party .so files that are not signed by this team. Without this,
         the hardened runtime refuses to load them and the app dies at import. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
